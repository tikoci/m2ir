{
	// CONTEXT: Project uses `bun` - these are mainly for `tsc --noEmit`
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": true
	},
	// Extracted third-party filesystem trees under work/ carry absolute
	// symlinks (e.g. var/tmp -> /tmp) that would otherwise pull the host's
	// /tmp scratch files into typechecking. Never typecheck them.
	"exclude": ["node_modules", "dist", "work/**/root-*", "work/**/dude-*"]
}
