{
	"version": 1,
	"hooks": {
		"sessionStart": [
			{
				"type": "command",
				"bash": "bun run hook:copilot -- --hook sessionStart",
				"powershell": "bun run hook:copilot -- --hook sessionStart",
				"cwd": ".",
				"timeoutSec": 10
			}
		],
		"sessionEnd": [
			{
				"type": "command",
				"bash": "bun run hook:copilot -- --hook sessionEnd",
				"powershell": "bun run hook:copilot -- --hook sessionEnd",
				"cwd": ".",
				"timeoutSec": 10
			}
		],
		"userPromptSubmitted": [
			{
				"type": "command",
				"bash": "bun run hook:copilot -- --hook userPromptSubmitted",
				"powershell": "bun run hook:copilot -- --hook userPromptSubmitted",
				"cwd": ".",
				"timeoutSec": 10
			}
		],
		"preToolUse": [
			{
				"type": "command",
				"bash": "bun run hook:copilot -- --hook preToolUse",
				"powershell": "bun run hook:copilot -- --hook preToolUse",
				"cwd": ".",
				"timeoutSec": 10
			}
		],
		"postToolUse": [
			{
				"type": "command",
				"bash": "bun run hook:copilot -- --hook postToolUse",
				"powershell": "bun run hook:copilot -- --hook postToolUse",
				"cwd": ".",
				"timeoutSec": 10
			}
		],
		"errorOccurred": [
			{
				"type": "command",
				"bash": "bun run hook:copilot -- --hook errorOccurred",
				"powershell": "bun run hook:copilot -- --hook errorOccurred",
				"cwd": ".",
				"timeoutSec": 10
			}
		]
	}
}
