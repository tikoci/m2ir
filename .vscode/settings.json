{
	// this project specifies its own MCPs, avoid duplicates -> but user settings should still override
	"chat.mcp.discovery.enabled": {
		"claude-desktop": false,
		"cursor-global": false,
		"windsurf": false
	},

	"chat.useNestedAgentsMdFiles": true,
	"chat.instructionsFilesLocations": {
		".github/instructions": true,
		"~/.copilot/instructions": true,
		"~/.claude/rules": false
	},
	// Copilot should use AGENTS.md and .github/instructions directly.
	"chat.useClaudeMdFile": false,
	// allow subagents to read complex skills with `fork`
	"github.copilot.chat.skillTool.enabled": true,
	"editor.tabCompletion": "on",
	"editor.insertSpaces": true,
	// for github workflows, and other YAML, allow completion
	"yaml.completion": true,
	// cSpell
	"cSpell.autocorrect": true
}
